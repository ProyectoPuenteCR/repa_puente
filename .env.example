# Administrador de respaldo (los demás usuarios se crean desde la pestaña Usuarios)
ADMIN_USER=admin
ADMIN_PASS=Admin
# Secreto para firmar la sesión (cualquier texto largo y aleatorio)
SESSION_SECRET=poné-acá-un-texto-largo-y-aleatorio
# Lo crea Vercel solo al conectar el Blob store
BLOB_READ_WRITE_TOKEN=
# Opcional: Access Token de Mercado Pago (empezá con uno TEST-...)
MP_ACCESS_TOKEN=
# Link de cobro fijo de Mercado Pago (por defecto https://link.mercadopago.com.ar/repopuente)
MP_LINK=
# Envío de emails de aviso (resend.com). MAIL_FROM es opcional
RESEND_API_KEY=
MAIL_FROM=
